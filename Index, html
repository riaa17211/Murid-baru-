        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Form Left -->
          <div class="lg:col-span-5 glass-card p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <i class="fa-solid fa-pen-nib text-tolitoli-500"></i>
              <span>Tulis Pesanmu</span>
            </h3>

            <form id="guestbook-form" onsubmit="submitGuestbook(event)" class="space-y-4">
              <div>
                <label for="gb-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Nama Kamu *</label>
                <input type="text" id="gb-name" required placeholder="Contoh: Budi Prasetyo" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-tolitoli-500">
              </div>

              <div>
                <label for="gb-class" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Kelas / Teman *</label>
                <input type="text" id="gb-class" required placeholder="Contoh: Kelas 10-A / Teman Ekstra" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-tolitoli-500">
              </div>

              <div>
                <label for="gb-message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Pesan / Ucapan hangat *</label>
                <textarea id="gb-message" rows="3" required placeholder="Halo Masria! Selamat datang di sekolah kami..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-tolitoli-500"></textarea>
              </div>

              <!-- Emoji Avatar Select -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Pilih Badge Emoji Avatar</label>
                <div class="flex items-center gap-2" id="emoji-picker">
                  <button type="button" onclick="selectEmoji('😊')" class="emoji-btn w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-lg flex items-center justify-center bg-tolitoli-50 dark:bg-tolitoli-900/40 border-tolitoli-500">😊</button>
                  <button type="button" onclick="selectEmoji('👋')" class="emoji-btn w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-lg flex items-center justify-center hover:bg-slate-100 dark:hover:bg-slate-800">👋</button>
                  <button type="button" onclick="selectEmoji('✨')" class="emoji-btn w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-lg flex items-center justify-center hover:bg-slate-100 dark:hover:bg-slate-800">✨</button>
                  <button type="button" onclick="selectEmoji('🌟')" class="emoji-btn w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-lg flex items-center justify-center hover:bg-slate-100 dark:hover:bg-slate-800">🌟</button>
                  <button type="button" onclick="selectEmoji('🎓')" class="emoji-btn w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-lg flex items-center justify-center hover:bg-slate-100 dark:hover:bg-slate-800">🎓</button>
                </div>
              </div>

              <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-tolitoli-500 to-sky-500 hover:from-tolitoli-600 hover:to-sky-600 text-white font-semibold text-sm shadow-md shadow-tolitoli-500/20 transition-all flex items-center justify-center gap-2">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Kirim Pesan</span>
              </button>
            </form>
          </div>

          <!-- Messages List Right -->
          <div class="lg:col-span-7 space-y-4">
            <div class="flex items-center justify-between px-2">
              <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-comments text-sky-500"></i>
                <span>Pesan dari Teman-Teman (<span id="gb-count">0</span>)</span>
              </h3>
              <span class="text-xs text-slate-500 dark:text-slate-400">Tersimpan secara dinamis</span>
            </div>

            <!-- Messages Container -->
            <div id="messages-container" class="space-y-3 max-h-[480px] overflow-y-auto pr-1">
              <!-- Rendered Dynamically -->
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-16 bg-white/60 dark:bg-slate-800/40 border-t border-slate-200/60 dark:border-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        
        <div class="max-w-xl mx-auto space-y-3">
          <h2 class="text-xs uppercase font-bold tracking-widest text-tolitoli-600 dark:text-tolitoli-400">Mari Terhubung</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Ingin Belajar atau Mengobrol Bersama?</p>
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Masria selalu senang berkenalan dengan teman-teman sekolah. Kamu bisa menghubungi lewat kontak berikut!
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <!-- Email Button -->
          <a href="mailto:masria.tolitoli@example.com" class="px-5 py-3 rounded-2xl glass-card border border-slate-200 dark:border-slate-700 hover:border-tolitoli-500 text-slate-800 dark:text-slate-200 font-semibold text-sm flex items-center gap-3 shadow-sm hover:-translate-y-0.5 transition-all">
            <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-500 flex items-center justify-center">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <span>Email Masria</span>
          </a>

          <!-- Instagram Button -->
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-2xl glass-card border border-slate-200 dark:border-slate-700 hover:border-tolitoli-500 text-slate-800 dark:text-slate-200 font-semibold text-sm flex items-center gap-3 shadow-sm hover:-translate-y-0.5 transition-all">
            <div class="w-8 h-8 rounded-lg bg-fuchsia-100 text-fuchsia-500 flex items-center justify-center">
              <i class="fa-brands fa-instagram"></i>
            </div>
            <span>Instagram</span>
          </a>

          <!-- Copy Contact Info -->
          <button onclick="copyContact()" class="px-5 py-3 rounded-2xl glass-card border border-slate-200 dark:border-slate-700 hover:border-tolitoli-500 text-slate-800 dark:text-slate-200 font-semibold text-sm flex items-center gap-3 shadow-sm hover:-translate-y-0.5 transition-all">
            <div class="w-8 h-8 rounded-lg bg-tolitoli-100 text-tolitoli-600 flex items-center justify-center">
              <i class="fa-solid fa-copy"></i>
            </div>
            <span id="copy-btn-text">Salin Kontak Info</span>
          </button>
        </div>

      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-8 text-center text-xs text-slate-500 dark:text-slate-400">
    <div class="max-w-6xl mx-auto px-4 space-y-2">
      <p>&copy; 2026 Masria — Siswa Baru asal Tolitoli. Dibuat penuh kehangatan untuk teman-teman semua. ✨</p>
      <p class="text-[11px] text-slate-400 dark:text-slate-600">Ramah • Baik Hati • Suka Membantu • Semangat Belajar</p>
    </div>
  </footer>

  <!-- "Sapa Masria" Modal -->
  <div id="greet-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="glass-card max-w-md w-full rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-700 shadow-2xl text-center space-y-4 scale-95 transition-transform duration-300 transform" id="greet-modal-card">
      
      <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-tolitoli-500 to-sky-400 text-white text-3xl flex items-center justify-center mx-auto shadow-lg shadow-tolitoli-500/30">
        👋
      </div>

      <h3 class="text-2xl font-bold text-slate-900 dark:text-white">Halo, Salam Kenal! ✨</h3>

      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        "Terima kasih sudah mengunjungi portofolio saya! Saya Masria dari Tolitoli. Semoga hari kamu menyenangkan dan mari kita saling bantu serta jadi teman yang baik di sekolah!"
      </p>

      <div class="p-3 bg-tolitoli-50 dark:bg-tolitoli-950/40 rounded-2xl text-xs text-tolitoli-700 dark:text-tolitoli-300 font-medium">
        🌺 Warm Greeting from Tolitoli, Central Sulawesi!
      </div>

      <button onclick="closeGreetModal()" class="w-full py-3 rounded-xl bg-tolitoli-500 hover:bg-tolitoli-600 text-white font-semibold text-sm shadow-md transition-colors">
        Tutup & Senyum 😊
      </button>
    </div>
  </div>

  <!-- Custom Toast Notification -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <span id="toast-icon">✨</span>
    <span id="toast-msg">Notifikasi</span>
  </div>

  <script>
    /* -------------------------------------------------------------
     * 1. Theme Toggle (Dark Mode / Light Mode)
     * ------------------------------------------------------------- */
    const themeToggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function initTheme() {
      const savedTheme = localStorage.getItem('masria_theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        document.documentElement.classList.remove('dark');
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }

    themeToggleBtn.addEventListener('click', () => {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('masria_theme', 'light');
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
        showToast('☀️ Mode Terang Diterapkan');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('masria_theme', 'dark');
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
        showToast('🌙 Mode Gelap Diterapkan');
      }
    });

    initTheme();

    /* -------------------------------------------------------------
     * 2. Mobile Menu Toggle
     * ------------------------------------------------------------- */
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Close menu when clicking link
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });

    /* -------------------------------------------------------------
     * 3. Dynamic Time-based Greeting
     * ------------------------------------------------------------- */
    function setDynamicGreeting() {
      const hours = new Date().getHours();
      const greetingElem = document.getElementById('dynamic-greeting');
      const iconElem = document.getElementById('time-icon');

      if (hours >= 5 && hours < 11) {
        greetingElem.textContent = 'Selamat Pagi, Teman-teman! 🌅';
        iconElem.innerHTML = '<i class="fa-solid fa-sun text-amber-500"></i>';
      } else if (hours >= 11 && hours < 15) {
        greetingElem.textContent = 'Selamat Siang! Semangat Belajar ☀️';
        iconElem.innerHTML = '<i class="fa-solid fa-sun text-amber-400"></i>';
      } else if (hours >= 15 && hours < 18) {
        greetingElem.textContent = 'Selamat Sore! Selamat Beristirahat 🌤️';
        iconElem.innerHTML = '<i class="fa-solid fa-cloud-sun text-orange-400"></i>';
      } else {
        greetingElem.textContent = 'Selamat Malam! Semoga Harimu Indah 🌙';
        iconElem.innerHTML = '<i class="fa-solid fa-moon text-indigo-400"></i>';
      }
    }

    setDynamicGreeting();

    /* -------------------------------------------------------------
     * 4. Sapa Masria Modal & Confetti
     * ------------------------------------------------------------- */
    const greetModal = document.getElementById('greet-modal');
    const greetCard = document.getElementById('greet-modal-card');

    function openGreetModal() {
      greetModal.classList.remove('opacity-0', 'pointer-events-none');
      greetCard.classList.remove('scale-95');
      greetCard.classList.add('scale-100');

      // Trigger Confetti
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 70,
          spread: 60,
          origin: { y: 0.6 }
        });
      }
    }

    function closeGreetModal() {
      greetModal.classList.add('opacity-0', 'pointer-events-none');
      greetCard.classList.remove('scale-100');
      greetCard.classList.add('scale-95');
    }

    /* -------------------------------------------------------------
     * 5. Interactive Like Counter
     * ------------------------------------------------------------- */
    let likes = parseInt(localStorage.getItem('masria_likes')) || 12;
    document.getElementById('like-count').textContent = likes;

    function addLike() {
      likes++;
      document.getElementById('like-count').textContent = likes;
      localStorage.setItem('masria_likes', likes);

      if (typeof confetti === 'function') {
        confetti({
          particleCount: 25,
          spread: 40,
          origin: { y: 0.7 }
        });
      }
      showToast('❤️ Terima kasih atas dukungannya!');
    }

    /* -------------------------------------------------------------
     * 6. Tolitoli Trivia Quiz System
     * ------------------------------------------------------------- */
    const quizQuestions = [
      {
        question: "1. Apa julukan terkenal untuk Kabupaten Tolitoli?",
        options: [
          "A. Kota Apel",
          "B. Kota Cengkeh",
          "C. Kota Hujan",
          "D. Kota Bahari"
        ],
        answer: 1, // Index B
        fact: "Tolitoli dikenal sebagai Kota Cengkeh karena merupakan salah satu penghasil cengkeh kualitas terbaik di Sulawesi Tengah!"
      },
      {
        question: "2. Salah satu daya tarik wisata alam unggulan Tolitoli adalah...",
        options: [
          "A. Candi Borobudur",
          "B. Danau Toba",
          "C. Pulau Lutungan & Pantai Lalos",
          "D. Gunung Bromo"
        ],
        answer: 2,
        fact: "Pulau Lutungan dan Pantai Lalos adalah destinasi kebanggaan warga Tolitoli dengan pasir putih dan keasrian air lautnya!"
      },
      {
        question: "3. Sifat utama yang selalu dibawa Masria kepada teman-teman baru adalah...",
        options: [
          "A. Pendiam & Acuh",
          "B. Suka Mengeluh",
          "C. Ramah, Baik Hati, & Suka Membantu",
          "D. Suka Menyendiri"
        ],
        answer: 2,
        fact: "Tepat sekali! Masria selalu mengutamakan keramahan, kebaikan hati, dan siap saling bantu dengan semua teman sekelas."
      }
    ];

    let currentQ = 0;
    let score = 0;

    function renderQuiz() {
      const container = document.getElementById('quiz-container');
      
      if (currentQ < quizQuestions.length) {
        const q = quizQuestions[currentQ];
        container.innerHTML = `
          <div class="space-y-4">
            <div class="flex justify-between items-center text-xs font-semibold text-tolitoli-600 dark:text-tolitoli-400">
              <span>Pertanyaan ${currentQ + 1} dari ${quizQuestions.length}</span>
              <span>Skor: ${score}</span>
            </div>
            
            <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">${q.question}</h4>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              ${q.options.map((opt, idx) => `
                <button onclick="answerQuiz(${idx})" class="text-left p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/60 hover:border-tolitoli-500 dark:hover:border-tolitoli-500 hover:bg-tolitoli-50/50 dark:hover:bg-slate-700 transition-all text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
                  ${opt}
                </button>
              `).join('')}
            </div>
          </div>
        `;
      } else {
        container.innerHTML = `
          <div class="text-center py-6 space-y-4">
            <div class="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-500 text-3xl flex items-center justify-center mx-auto">
              🏆
            </div>
            <h4 class="text-2xl font-bold text-slate-900 dark:text-white">Kuis Selesai!</h4>
            <p class="text-sm text-slate-600 dark:text-slate-300">
              Kamu berhasil menjawab benar <strong class="text-tolitoli-500 font-bold">${score}</strong> dari <strong>${quizQuestions.length}</strong> pertanyaan! Now you know Tolitoli & Masria better! 🎉
            </p>
            <button onclick="resetQuiz()" class="px-6 py-2.5 rounded-xl bg-tolitoli-500 hover:bg-tolitoli-600 text-white font-semibold text-xs shadow-md transition-colors">
              Ulangi Kuis 🔄
            </button>
          </div>
        `;
      }
    }

    function answerQuiz(selectedIdx) {
      const q = quizQuestions[currentQ];
      if (selectedIdx === q.answer) {
        score++;
        showToast('✅ Jawaban Benar! ' + q.fact);
      } else {
        showToast('❌ Kurang Tepat. ' + q.fact);
      }
      currentQ++;
      renderQuiz();
    }

    function resetQuiz() {
      currentQ = 0;
      score = 0;
      renderQuiz();
    }

    renderQuiz();

    /* -------------------------------------------------------------
     * 7. Guestbook System with LocalStorage
     * ------------------------------------------------------------- */
    let selectedEmoji = '😊';

    function selectEmoji(emoji) {
      selectedEmoji = emoji;
      document.querySelectorAll('.emoji-btn').forEach(btn => {
        btn.classList.remove('bg-tolitoli-50', 'dark:bg-tolitoli-900/40', 'border-tolitoli-500');
        if (btn.textContent.trim() === emoji) {
          btn.classList.add('bg-tolitoli-50', 'dark:bg-tolitoli-900/40', 'border-tolitoli-500');
        }
      });
    }

    const initialMessages = [
      {
        name: "Siti Rahma",
        class: "Kelas X-1",
        message: "Selamat datang di sekolah kami Masria! Semoga betah dan bisa belajar bareng ya!",
        emoji: "👋",
        time: "Kemarin"
      },
      {
        name: "Rian Hidayat",
        class: "Teman Osis",
        message: "Salam kenal Masria dari Tolitoli! Penasaran ingin dengar cerita lebih banyak tentang Kota Cengkeh.",
        emoji: "🌟",
        time: "Hari ini"
      }
    ];

    function getGuestbookMessages() {
      const stored = localStorage.getItem('masria_guestbook');
      if (stored) {
        return JSON.parse(stored);
      } else {
        localStorage.setItem('masria_guestbook', JSON.stringify(initialMessages));
        return initialMessages;
      }
    }

    function renderGuestbook() {
      const messages = getGuestbookMessages();
      const container = document.getElementById('messages-container');
      const countElem = document.getElementById('gb-count');

      countElem.textContent = messages.length;

      if (messages.length === 0) {
        container.innerHTML = `
          <div class="p-8 text-center text-xs text-slate-400 glass-card rounded-2xl">
            Belum ada pesan. Jadi orang pertama yang menyapa Masria! 😊
          </div>
        `;
        return;
      }

      container.innerHTML = messages.map((m, idx) => `
        <div class="glass-card p-4 rounded-2xl border border-slate-200 dark:border-slate-700/80 shadow-sm space-y-2 relative group hover:border-tolitoli-500/50 transition-all">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-full bg-tolitoli-100 dark:bg-tolitoli-900/50 flex items-center justify-center text-base">
                ${m.emoji || '😊'}
              </span>
              <div>
                <h4 class="font-bold text-xs text-slate-900 dark:text-white">${m.name}</h4>
                <p class="text-[10px] text-tolitoli-600 dark:text-tolitoli-400 font-medium">${m.class}</p>
              </div>
            </div>
            <span class="text-[10px] text-slate-400">${m.time}</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed pl-10">
            "${m.message}"
          </p>
        </div>
      `).join('');
    }

    function submitGuestbook(e) {
      e.preventDefault();
      const name = document.getElementById('gb-name').value.trim();
      const cls = document.getElementById('gb-class').value.trim();
      const msg = document.getElementById('gb-message').value.trim();

      if (!name || !cls || !msg) return;

      const newEntry = {
        name: name,
        class: cls,
        message: msg,
        emoji: selectedEmoji,
        time: 'Baru saja'
      };

      const messages = getGuestbookMessages();
      messages.unshift(newEntry);
      localStorage.setItem('masria_guestbook', JSON.stringify(messages));

      // Reset Form
      document.getElementById('guestbook-form').reset();
      selectEmoji('😊');

      renderGuestbook();
      showToast('💌 Pesan berhasil dikirim ke Masria!');

      if (typeof confetti === 'function') {
        confetti({ particleCount: 40, spread: 50, origin: { y: 0.8 } });
      }
    }

    renderGuestbook();

    /* -------------------------------------------------------------
     * 8. Copy Contact Helper
     * ------------------------------------------------------------- */
    function copyContact() {
      const textToCopy = "Kontak Masria (Siswa Baru asal Tolitoli) - Email: masria.tolitoli@example.com";
      
      // Clipboard API with Fallback
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(textToCopy);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = textToCopy;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      showToast('📋 Informasi kontak berhasil disalin!');
    }

    /* -------------------------------------------------------------
     * 9. Toast Notification System
     * ------------------------------------------------------------- */
    let toastTimeout;
    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');

      toastMsg.textContent = msg;

      toast.classList.remove('opacity-0', 'translate-y-20', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-20', 'pointer-events-none');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 3500);
    }
  </script>
</body>
</html>
